{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.drlizlondon.com" }], "destination": "https://drlizlondon.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "lizzie-profile.vercel.app" }], "destination": "https://drlizlondon.com/:path*", "permanent": true },
    { "source": "/fable-prompt", "destination": "/betty-prompt", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] }
  ]
}
