{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "main.js",
    "build-a-business*.js",
    "resources*.js",
    "watch-ai*.js",
    "fable-api.js",
    "fable-pro-content.js",
    "fable-pro.js",
    "site-events.js",
    "unsubscribe.js",
    "projects/project.js",
    "tests/**/*.js"
  ]
}
